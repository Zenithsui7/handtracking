{
  "compileOnSave": false,
  "compilerOptions": {
    "moduleResolution": "node",
    "allowUnreachableCode": true,
    "module": "es2020",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "outDir": "dist",
    "target": "es2020",
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": [
      "@types/emscripten"
    ],
    "lib": [
      "dom",
      "es2020"
    ]
  },
  "include": [
    "src"
  ]
}
